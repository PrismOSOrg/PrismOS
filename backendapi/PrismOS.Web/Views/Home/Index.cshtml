@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> PRISMOS PACKAGE REPOSITORY</p>
        <h1>Packages for your <span>PrismOS.</span></h1>
        <p class="hero-description">
            A simple home for PrismOS packages. Browse the catalog or connect with the
            package-manager API.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="/api/v1/catalog">Browse package catalog <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/healthz">Check API status</a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-outer"></div>
        <div class="orbit orbit-inner"></div>
        <div class="prism">P</div>
    </div>
</section>

<section class="content-section" aria-labelledby="getting-started">
    <div class="section-heading">
        <p class="eyebrow">GETTING STARTED</p>
        <h2 id="getting-started">Everything you need to connect.</h2>
    </div>
    <div class="info-grid">
        <article class="info-card">
            <span class="card-number">01</span>
            <h3>Explore packages</h3>
            <p>See the packages currently available in the repository catalog.</p>
            <a href="/api/v1/catalog">Open catalog <span aria-hidden="true">→</span></a>
        </article>
        <article class="info-card">
            <span class="card-number">02</span>
            <h3>Connect your tools</h3>
            <p>The versioned HTTP API remains available for the PrismOS package manager.</p>
            <a href="/healthz">View service status <span aria-hidden="true">→</span></a>
        </article>
        <article class="info-card">
            <span class="card-number">03</span>
            <h3>More is on the way</h3>
            <p>This is the starting point. Package browsing and account tools can grow from here.</p>
            <span class="card-note">PrismOS · Package repository</span>
        </article>
    </div>
</section>
